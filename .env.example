# Supabase project (Settings -> API). The anon key is public; the service-role key is a SECRET.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed app, used in invitation and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Voice providers: NOT used yet. No vendor adapter is implemented; see src/lib/voice/providers.ts.
# SARVAM_API_KEY=
# TELEPHONY_PROVIDER=
